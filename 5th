import pandas as pd
import matplotlib.pyplot as plt

data = {
    'Student_ID': [101, 102, 103, 104, 105],
    'Completion_Status': ['Yes', 'No', None, 'Yes', 'No']
}


df = pd.DataFrame(data)

df['Completion_Status'] = df['Completion_Status'].fillna('No')

print(df)

completion_count = df['Completion_Status'].value_counts()

print("\nCompletion Count:")
print(completion_count)

plt.pie(completion_count,
        labels=completion_count.index,
        autopct='%1.1f%%')

plt.title("Course Completion Status")

plt.show()
